// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// Usuário — id igual ao id do usuário no Supabase Auth (auth.users.id).
// Criado pelo webhook da Hotmart (Compra Aprovada) ou por outro fluxo de
// provisionamento; a senha em si vive inteiramente no Supabase Auth.
// =========================================================================
model User {
  id              String    @id
  name            String
  email           String    @unique
  isAdmin         Boolean   @default(false)
  accessExpiresAt DateTime?
  accessRevokedAt DateTime?
  checkinWeekday  Int? // 0 (domingo) a 6 (sábado) — definido na Etapa 6, editável nas Configurações
  notifyEmail     Boolean   @default(true)
  notifyPush      Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  diagnostics         Diagnostic[]
  plans               Plan[]
  hotmartTransactions HotmartTransaction[]
  pushSubscriptions   PushSubscription[]
  agendaEntries       AgendaEntry[]

  @@map("users")
}

enum Intention {
  SAIR
  COMPLEMENTAR
  NAO_SEI
  JA_FORA_DA_SALA

  @@map("intention")
}

enum DiagnosticStatus {
  EM_ANDAMENTO
  CONCLUIDO

  @@map("diagnostic_status")
}

enum RotaProfissional {
  CARREIRA
  CRIACAO_VALOR
  EXPLORACAO

  @@map("rota_profissional")
}

// =========================================================================
// Diagnóstico — Bloco 0 (Intenção) + Blocos A-D (comuns) + bloco condicional
// pela rota profissional. As respostas em si ficam em `answers` (JSON), pois
// a redação/estrutura das perguntas pode evoluir sem exigir migração de
// schema; o formato esperado está documentado em
// Questionario_Descoberta_Unificado_MaisQueProfessor.docx.
// =========================================================================
model Diagnostic {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  intention          Intention
  rotaProfissional   RotaProfissional? // respondida na 2ª pergunta (Bloco A) — nula até lá
  answers            Json // Blocos A-D + bloco condicional da rota
  incrementAnswers   Json? // incremento de diagnóstico (10-12 perguntas, caso raro — após 3 rodadas sem aprovação)
  incrementUsedAt    DateTime? // marca a única execução permitida do incremento — nunca reseta, evita gerar rodadas extras ilimitadas
  status             DiagnosticStatus  @default(EM_ANDAMENTO)
  versaoQuestionario String            @default("descoberta_v1")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  rounds GenerationRound[]

  @@map("diagnostics")
}

// =========================================================================
// Rodada de geração — cada rodada produz exatamente 5 Possibility.
// roundNumber 1 = geração inicial; 2-4 = até 3 rodadas de ajuste;
// 5 = regeneração após incremento de diagnóstico (caso raro).
// =========================================================================
model GenerationRound {
  id           String     @id @default(uuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  roundNumber  Int
  feedbackText String?    @db.Text // feedback do professor sobre o conjunto anterior (null na rodada 1)
  status       GenerationRoundStatus @default(PROCESSANDO)
  versaoMotor  String? // "v4" — só informativo, qual motor gerou esta rodada
  rascunhoAtual Json? // rascunho do gerador (já mesclado com correção, se houver) — inclui as reservas por papel; consumido entre as fases da fila
  auditoriaAtual Json? // último resultado do auditor (status/manter/substituir/motivo) — consumido pela fase de correção
  correcaoTentada Boolean @default(false) // no máximo 1 correção direcionada; se a verificação final ainda reprovar, tenta reserva
  claimedAt    DateTime? // lock otimista: setado atomicamente ANTES da chamada à OpenAI de cada fase (ver claimPhase em run-generation-pipeline.ts); expira sozinho depois de CLAIM_TIMEOUT_MS, permitindo retomar uma fase abandonada sem duplicar a chamada
  metaFinanceiraUsada Json? // valor_mensal (null quando o professor não respondeu) + natureza + prazo_desejado — só preenchido em CONCLUIDO
  avisoEconomico String? @db.Text // aviso fixo de que são hipóteses de construção/monetização, não promessa de renda — só preenchido em CONCLUIDO
  macroNicho Json? // nome, explicacao (com pelo menos 3 evidências citadas), nichoSecundario — identificado ANTES das 5 possibilidades (ver system-prompt.ts), exibido pro professor antes dos cards. Motor "macro nicho" (2026-09) — null em rodadas geradas antes dessa mudança.
  premissasFinanceirasGerais String? @db.Text // aviso único sobre as premissas usadas na trajetória financeira das 5 (meta/público/disponibilidade não informados etc.) — evita repetir o mesmo aviso em cada possibilidade
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt // usado pra detectar rodada travada entre fases (ver polling-wait.tsx)

  possibilities Possibility[]

  @@unique([diagnosticId, roundNumber])
  @@map("generation_rounds")
}

enum PossibilityRole {
  ONDE_JA_E_FORTE
  PARA_ONDE_QUER_IR
  O_QUE_PODE_MOBILIZAR
  COMO_QUER_TRABALHAR_E_CRESCER // não é mais gerado (substituído por MAIOR_CONVERGENCIA_COMERCIAL) — mantido no enum só porque remover valor de enum no Postgres exige recriar o tipo
  NAO_CONSIDERADA
  MAIOR_CONVERGENCIA_COMERCIAL

  @@map("possibility_role")
}

enum PossibilityStatus {
  PENDENTE
  APROVADA
  REJEITADA

  @@map("possibility_status")
}

enum GenerationRoundStatus {
  PROCESSANDO // legado (motor V3) — nenhum round novo usa mais, mantido só porque o Postgres não permite remover valor de enum sem recriar o tipo
  PRONTO // legado (motor V3), equivalente a CONCLUIDO
  PENDENTE
  GERANDO
  VALIDANDO
  CORRIGINDO
  CONCLUIDO
  FALHOU

  @@map("generation_round_status")
}

enum HorizonteEconomico {
  CURTO_PRAZO
  MEDIO_PRAZO
  LONGO_PRAZO
  A_VALIDAR // só usado por horizonteRelevanciaFinanceira, nunca por tempoPrimeiraValidacao

  @@map("horizonte_economico")
}

enum NivelLastro {
  FORTE
  MODERADO
  EXPLORATORIO

  @@map("nivel_lastro")
}

model Possibility {
  id                   String             @id @default(uuid())
  roundId              String
  round                GenerationRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  papel                PossibilityRole
  titulo               String
  subtitulo            String // frase (12-24 palavras) do card fechado — o que a pessoa faria, para quem e com qual finalidade
  tempoPrimeiraValidacao       HorizonteEconomico // nunca A_VALIDAR
  horizonteRelevanciaFinanceira HorizonteEconomico // pode ser A_VALIDAR quando faltar base (meta financeira etc.)
  baseNoHistorico      NivelLastro
  destaque             Boolean            @default(false) // true só na possibilidade MAIOR_CONVERGENCIA_COMERCIAL
  comoFunciona         String             @db.Text // bloco 1 — "A possibilidade"
  comoGerarReceita     String             @db.Text // bloco 3 — "Como pode gerar receita" (funde o antigo quemPagariaEComo + caminhoEconomico)
  porQueCombinaComVoce String             @db.Text // bloco 2 — "Por que combina com você"
  primeiraValidacao    String             @db.Text // bloco 4 — "Como validar sem construir tudo"
  pontoDeAtencao       String             @db.Text // bloco 5 — "Ponto de atenção"
  impressaoDigital     Json // impressão digital semântica compacta (papel/território/problema/público/pagador/entrega/modelo_receita/evidências/risco/confiança) — nunca exibido ao professor, usado pelo auditor pra comparar possibilidades
  analiseConvergenciaComercial Json? // só a possibilidade com destaque=true tem; null nas outras 4
  mapaExecucao         Json? // gerado só depois que o professor aprova esta possibilidade (ver adequacao/[possibilityId]/concluido/actions.ts) — null até lá
  feedbackMissoesAtivacao Json? // respostas gerais pós-missões (vontade de continuar, horas reais por semana, dificuldade principal) — null até o professor concluir as 3 missões
  analiseMercadoAmpliada Json? // camada aditiva antiga (pré macro-nicho) — mantida só por compatibilidade com rodadas geradas antes de 2026-09; o motor novo já embute conexão com mercado + trajetória financeira direto na geração (ver campos abaixo), então essa fase separada não é mais disparada.
  dominioAplicacao     String? // eixo 1 de diversidade: pra que tipo de comprador o macro nicho é aplicado nesta possibilidade
  mecanismoComercialClasse String? // eixo 2: servico_projeto | produto_digital | software_recorrente | intermediacao | operacao_recorrente | conteudo
  profundidade         String? // eixo 3: diagnostico_pontual | acompanhamento_recorrente | uso_autonomo
  conexaoMundoReal     Json? // nomeDeMercado (pode ser null se genuinamente não existir), reconhecimentoMercado, compradoresNomeados[]
  trajetoriaFinanceira Json? // cenarioInicial/ano1/ano3/ano5 (cada um: premissas + resultadoLiquidoEstimado), logicaDeCrescimento, riscoEstrutural, aviso
  tempoDedicacao       Json? // horas/semana aproximadas: inicial, ano3, ano5
  status               PossibilityStatus  @default(PENDENTE)
  createdAt            DateTime           @default(now())

  plan              Plan?
  adequacaoResponse AdequacaoResponse?
  missoesAtivacao   MissaoAtivacao[]

  @@map("possibilities")
}

enum MissaoTipo {
  CAPACIDADE // "eu consigo fazer alguma versão pequena disso?"
  REALIDADE // "isso existe fora da minha cabeça?"
  VALIDACAO // "eu consigo gerar algum valor real com isso?"

  @@map("missao_tipo")
}

enum MissaoConclusao {
  TOTAL
  PARCIAL
  NAO

  @@map("missao_conclusao")
}

// =========================================================================
// Missões de Ativação — Bloco 0 da rota: 3 missões pequenas, geradas depois
// da adequação (já temos o Mapa de Execução + as respostas de adequação
// como matéria-prima) e antes do Plano de Execução Personalizado. Servem
// pra colocar a possibilidade escolhida em contato com a realidade antes de
// comprometer 4-12 semanas — não são conteúdo, são um teste rápido.
// =========================================================================
model MissaoAtivacao {
  id            String         @id @default(uuid())
  possibilityId String
  possibility   Possibility    @relation(fields: [possibilityId], references: [id], onDelete: Cascade)
  ordem         Int // 1-3
  tipo          MissaoTipo
  nome          String
  objetivo      String         @db.Text
  porQueExiste  String         @db.Text
  tempoEstimadoMinutos Int
  recursosNecessarios  String  @db.Text
  passoAPasso   Json // string[] — 3 a 6 passos curtos
  criterioConclusao   String   @db.Text
  evidenciaEsperada   String   @db.Text
  perguntaReflexao    String   @db.Text

  // Preenchido pelo professor depois de executar (ou tentar executar)
  conseguiuConcluir MissaoConclusao?
  tempoRealMinutos  Int?
  oQueAconteceu     String?          @db.Text
  reflexao          String?         @db.Text
  respondidoEm      DateTime?

  createdAt DateTime @default(now())

  @@unique([possibilityId, ordem])
  @@map("missoes_ativacao")
}

// =========================================================================
// Respostas do questionário de adequação da execução — perguntado depois que
// uma Possibility é aprovada, antes de gerar o Plan. Mesmo padrão de
// autosave em JSON do Diagnostic (wizard, uma pergunta por tela). O formato
// esperado está documentado em
// Questionario_Adequacao_Execucao_MaisQueProfessor.docx.
// =========================================================================
model AdequacaoResponse {
  id                 String           @id @default(uuid())
  possibilityId      String           @unique
  possibility        Possibility      @relation(fields: [possibilityId], references: [id], onDelete: Cascade)
  answers            Json             @default("{}")
  status             DiagnosticStatus @default(EM_ANDAMENTO)
  versaoQuestionario String           @default("adequacao_v1")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("adequacao_responses")
}

enum PlanStatus {
  ATIVO
  PAUSADO
  CONGELADO

  @@map("plan_status")
}

enum NivelAcompanhamento {
  MINIMO
  MEDIO
  ALTO

  @@map("nivel_acompanhamento")
}

enum OrcamentoFaixa {
  SEM_INVESTIMENTO
  ATE_300
  DE_300_A_1000
  ACIMA_DE_1000

  @@map("orcamento_faixa")
}

enum EstagioInicial {
  NUNCA_FIZ
  PESQUISEI_NAO_EXECUTEI
  FIZ_ISOLADO
  TENHO_CASO_PORTFOLIO
  ATUO_PARCIALMENTE

  @@map("estagio_inicial")
}

enum DistribuicaoTempo {
  BLOCO_UNICO
  BLOCOS_MEDIOS
  SESSOES_CURTAS
  AGENDA_VARIAVEL

  @@map("distribuicao_tempo")
}

enum RegraSegurancaFinanceira {
  MANTER_RENDA_INTEGRAL
  SEM_COMPROMISSO_ANTES_EVIDENCIA
  TRANSICAO_GRADUAL
  MARGEM_PARA_DEDICAR
  NAO_SE_APLICA

  @@map("regra_seguranca_financeira")
}

enum EquilibrioAprenderExecutar {
  FOCO_EXECUCAO
  EQUILIBRADO
  FOCO_APRENDIZADO
  SISTEMA_RECOMENDA

  @@map("equilibrio_aprender_executar")
}

enum AcaoAceita {
  PESQUISAR
  CONVERSAR
  PRODUZIR_AMOSTRA
  PUBLICAR_CONTEUDO
  ENVIAR_CANDIDATURAS
  PROPOSTA_COMERCIAL
  PILOTO_REMUNERADO
  ATIVIDADE_PRESENCIAL
  PREPARAR_PRIVADAMENTE

  @@map("acao_aceita")
}

enum NivelExecucao {
  VALIDACAO
  IMPLEMENTACAO
  DESENVOLVIMENTO

  @@map("nivel_execucao")
}

enum RitmoDesejado {
  RAPIDO
  EQUILIBRADO
  GRADUAL
  SISTEMA_RECOMENDA

  @@map("ritmo_desejado")
}

// =========================================================================
// Plano Personalizado de Transição — nasce da aprovação de uma Possibility
// (Etapa 5) + questionário de adequação (Etapa 6). `relatorio` é gerado uma
// única vez e nunca reescrito; a recalibração (só por tempo) mexe em
// PlanWeek, nunca aqui.
//
// Duração é variável (4 a 12 semanas, ver src/lib/plano/formula.ts) — a IA
// escolhe o nível de execução (nivelExecucao) e a duração nasce do esforço
// correspondente no Mapa de Execução da possibilidade dividido pela
// capacidade semanal sustentável (horasNucleoSemana), sempre clampada em
// [4, 12]. Não é mais um multiplicador fixo por 12 semanas.
// =========================================================================
model Plan {
  id                         String                     @id @default(uuid())
  userId                     String
  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  possibilityId              String                     @unique
  possibility                Possibility                @relation(fields: [possibilityId], references: [id])
  status                     PlanStatus                 @default(ATIVO)
  tempoDisponivelHoras       Float // horas/semana declaradas na adequação
  horasNucleoSemana          Float // min(tempoDisponivelHoras, 10) — teto real de tarefas obrigatórias por semana
  investimentoFaixa          OrcamentoFaixa
  acompanhamento             NivelAcompanhamento?
  diaCheckin                 Int // 0-6, herdado do User na criação, pode divergir depois se o usuário mudar globalmente
  estagioInicial             EstagioInicial
  distribuicaoTempo          DistribuicaoTempo
  regraSegurancaFinanceira   RegraSegurancaFinanceira
  acoesAceitas               AcaoAceita[]
  equilibrioAprenderExecutar EquilibrioAprenderExecutar
  condicaoAdicionalExecucao  String?                    @db.Text
  ritmoDesejado              RitmoDesejado
  classificacaoEncaixe       String? // veredito da IA: cabe_agora | cabe_com_adaptacao | construcao_medio_prazo | conflito_explicito
  nivelExecucao              NivelExecucao // decidido pela IA: validação | implementação | desenvolvimento
  resultadoMinimoViavel      String                     @db.Text // RMV personalizado pra este plano
  ttfrSemanas                Int // Time To First Result — semanas até o primeiro resultado observável
  ttfrResultado              String                     @db.Text
  proporcaoAprendizado       Float // 0-1, proporção do plano dedicada a aprendizado/preparação (o resto é execução)
  relatorio                  Json // relatório completo fixo (Etapa 7) — nunca reescrito
  duracaoSemanas             Int // 4-12, calculada a partir do esforço do nível de execução escolhido ÷ horasNucleoSemana
  activatedAt                DateTime                   @default(now())
  pausedAt                   DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  weeks                       PlanWeek[]
  tasks                       PlanTask[]
  journalEntries              JournalEntry[]
  milestones                  PlanMilestone[]
  antiProcrastinacaoRespostas AntiProcrastinacaoResposta[]

  @@map("plans")
}

// =========================================================================
// Antiprocrastinação — os itens em si (título, explicação, fonte) são
// conteúdo fixo no código (src/lib/anti-procrastinacao/itens.ts), curado
// a partir de livros conhecidos sobre formação de hábitos — não gerado
// por IA. Só a resposta de cada pessoa (a ação que ELA registra) mora no
// banco, uma por item por plano. De propósito não fica ligado a nenhuma
// tarefa/semana específica: são hábitos da pessoa, não do checklist.
// =========================================================================
model AntiProcrastinacaoResposta {
  id        String   @id @default(uuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemKey   String
  resposta  String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([planId, itemKey])
  @@map("anti_procrastinacao_respostas")
}

// =========================================================================
// Marcos de evolução — 3 a 5 conquistas reais geradas pela IA junto com o
// plano (não são tarefas, são resultados que a pessoa vai reconhecer
// quando acontecerem, ex.: "primeira empresa aceita conversar"). Best
// effort: se a IA devolver menos de 3 ou nenhum, a seção some da tela em
// vez de falhar a geração inteira — não vale gastar de novo uma chamada
// de ~40s por causa de um extra.
//
// Marcado manualmente pela própria pessoa (achievedAt), igual a tudo mais
// no plano — nenhuma automação decide isso por ela, e não fica preso a
// nenhuma semana/tarefa específica pra sobreviver ao pool/pull da
// execução dinâmica sem precisar de lógica de sincronização.
// =========================================================================
enum MilestoneTipo {
  ENTREGA_CONTROLAVEL // depende só da própria pessoa executar
  SINAL_EXTERNO // depende de resposta de terceiros (ex.: retorno de mercado) — ausência não significa plano mal executado

  @@map("milestone_tipo")
}

model PlanMilestone {
  id         String        @id @default(uuid())
  planId     String
  plan       Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequencia  Int
  titulo     String
  descricao  String        @db.Text
  tipo       MilestoneTipo @default(ENTREGA_CONTROLAVEL)
  achievedAt DateTime?
  createdAt  DateTime      @default(now())

  @@map("plan_milestones")
}

enum WeekStatus {
  PENDENTE
  CONCLUIDA
  ATRASADA

  @@map("week_status")
}

model PlanWeek {
  id                      String     @id @default(uuid())
  planId                  String
  plan                    Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber              Int
  meta                    String     @db.Text
  dificuldadesAntecipadas String?    @db.Text // null nas semanas extras (criadas só pra receber pendências, sem conteúdo novo da IA)
  scheduledDate           DateTime // ajustada pela recalibração por tempo
  status                  WeekStatus @default(PENDENTE)
  completedAt             DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  tasks        PlanTask[]
  checkin      Checkin?
  journalEntry JournalEntry?

  @@unique([planId, weekNumber])
  @@map("plan_weeks")
}

enum TaskStatus {
  PENDENTE
  COMPLETO
  PARCIAL

  @@map("task_status")
}

enum TaskOrigin {
  PLANO // gerada pela IA na criação do plano
  PROPRIA // criada pela própria pessoa
  PENDENCIA // sobra de uma tarefa marcada como parcial

  @@map("task_origin")
}

// =========================================================================
// Tarefa individual do plano — substitui o antigo PlanWeek.tasks (JSON).
// planWeekId null = está no "pool" (pendência ou tarefa própria ainda não
// puxada pra nenhuma semana). Mover uma tarefa entre semanas, ou pro pool
// e de volta, é sempre uma ação manual da pessoa — nenhum algoritmo
// reorganiza isso sozinho (ver Análise "Execução Dinâmica do Plano").
// =========================================================================
model PlanTask {
  id             String     @id @default(uuid())
  planId         String
  plan           Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  planWeekId     String?
  planWeek       PlanWeek?  @relation(fields: [planWeekId], references: [id])
  texto          String     @db.Text
  horasEstimadas Float
  status         TaskStatus @default(PENDENTE)
  origin         TaskOrigin @default(PLANO)
  notaParcial    String?    @db.Text // só preenchido quando status = PARCIAL — o que ainda falta
  opcional       Boolean    @default(false) // tarefa além do núcleo semanal (horasNucleoSemana), só quando tempoDisponivelHoras > 10
  sequencia      Int // ordem original gerada pela IA, usada pra ordenar dentro da semana
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("plan_tasks")
}

enum ObstacleCategory {
  FALTA_DE_TEMPO
  FALTA_DE_INVESTIMENTO
  DIFICULDADE_TECNICA
  FALTA_DE_MOTIVACAO
  INSEGURANCA_OU_MEDO
  IMPREVISTO_PESSOAL_OU_EXTERNO
  NAO_HOUVE_OBSTACULO

  @@map("obstacle_category")
}

// doneItems/notDoneItems (texto livre) foram substituídos pelo checklist por
// item em PlanTask — o texto livre só existe mais no próprio item, quando
// marcado parcial (PlanTask.notaParcial). O check-in continua sendo o
// ritual de fechar a semana: categoriza o obstáculo e dispara a orientação.
model Checkin {
  id               String           @id @default(uuid())
  planWeekId       String           @unique
  planWeek         PlanWeek         @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  obstacleCategory ObstacleCategory
  freeText         String?          @db.Text
  createdAt        DateTime         @default(now())

  guidance ExecutionGuidance?

  @@map("checkins")
}

// =========================================================================
// Camada de Orientação de Execução — baseTipText vem da biblioteca fixa
// (Biblioteca_Orientacao_Execucao.md, selecionada pela obstacleCategory do
// check-in); personalizedText é a reescrita restrita por IA (Haiku).
// =========================================================================
model ExecutionGuidance {
  id               String   @id @default(uuid())
  checkinId        String   @unique
  checkin          Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  baseTipText      String   @db.Text
  personalizedText String   @db.Text
  createdAt        DateTime @default(now())

  @@map("execution_guidance")
}

model JournalEntry {
  id         String    @id @default(uuid())
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  planWeekId String?   @unique
  planWeek   PlanWeek? @relation(fields: [planWeekId], references: [id])
  text       String    @db.Text
  createdAt  DateTime  @default(now())

  @@map("journal_entries")
}

// =========================================================================
// Agenda pessoal — independente de Plan (a pessoa pode anotar qualquer
// coisa, não só tarefas do plano). Cada entrada pertence a uma "série"
// (seriesId): entradas criadas junto (replicar pra outros dias / pras
// próximas semanas) compartilham o mesmo seriesId, o que permite excluir
// só uma semana ou a partir dela em diante. Uma entrada avulsa (sem
// réplica) ainda ganha um seriesId próprio, só pra manter a mesma lógica
// de exclusão em todo lugar.
// =========================================================================
model AgendaEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId     String
  label        String
  color        String // token de uma paleta fixa curta (ver src/lib/agenda/colors.ts)
  weekday      Int // 0 (domingo) a 6 (sábado) — mesma convenção de WEEKDAY_LABELS
  startMinutes Int // minutos desde 00:00, múltiplo de 30
  endMinutes   Int
  weekStart    DateTime // segunda-feira (00:00) da semana desta entrada
  createdAt    DateTime @default(now())

  @@unique([userId, seriesId, weekStart, weekday])
  @@index([userId, weekStart])
  @@map("agenda_entries")
}

// =========================================================================
// Transações da Hotmart — transactionId único garante idempotência
// (a Hotmart pode reenviar o mesmo evento até 5x).
// =========================================================================
model HotmartTransaction {
  id            String   @id @default(uuid())
  transactionId String   @unique
  eventType     String // PURCHASE_APPROVED | PURCHASE_CANCELED | PURCHASE_REFUNDED | PURCHASE_CHARGEBACK | ...
  payload       Json
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  processedAt   DateTime @default(now())

  @@map("hotmart_transactions")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// =========================================================================
// TEMPORÁRIO — debug do erro nas chamadas de IA em produção. A Vercel no
// plano Hobby só guarda Runtime Logs por 1h, curto demais pra investigar
// com calma. Grava o erro real aqui pra consulta direta, sem depender de
// janela de tempo nenhuma. Remover depois que a causa for resolvida.
// =========================================================================
model DebugErrorLog {
  id        String   @id @default(uuid())
  context   String
  message   String   @db.Text
  stack     String?  @db.Text
  createdAt DateTime @default(now())

  @@map("debug_error_logs")
}
