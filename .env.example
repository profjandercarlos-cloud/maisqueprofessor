# === Banco de dados (Supabase Postgres, via pooler Supavisor — conexão direta é IPv6-only) ===
# Painel Supabase > Connect > Connection string (selecionar "Session pooler" / "Transaction pooler")
# DATABASE_URL: session pooler (porta 5432) — usada pelo Prisma CLI (migrate, studio)
# DATABASE_URL_POOLED: transaction pooler (porta 6543) — usada em runtime pelo app (funções serverless)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"
DATABASE_URL_POOLED="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"

# === Supabase (Auth + client) ===
# Painel Supabase > Project Settings > Chaves de API / Chaves JWT
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[PUBLISHABLE-KEY]"
SUPABASE_SECRET_KEY="[SECRET-KEY]"
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# === OpenAI (motor de IA) ===
# platform.openai.com > API Keys
OPENAI_API_KEY="sk-proj-..."

# === Hotmart (webhook) ===
HOTMART_HOTTOK="[TOKEN-DE-SEGURANCA-DO-WEBHOOK]"

# === E-mail transacional (Resend) ===
RESEND_API_KEY="re_..."
EMAIL_FROM="Mais Que Professor <contato@maisqueprofessor.com.br>"

# === App ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# === Cron (rotina diária — Vercel Cron Jobs) ===
# Qualquer string aleatória longa (ex.: `openssl rand -hex 24`). A Vercel envia
# esse valor automaticamente como header Authorization ao chamar o cron.
CRON_SECRET="[GERAR-STRING-ALEATORIA]"
